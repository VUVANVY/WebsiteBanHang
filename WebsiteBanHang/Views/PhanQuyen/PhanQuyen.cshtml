@using WebsiteBanHang.Models
@model LoaiThanhVien
@{
    ViewBag.Title = "Phân quyền thành viên";
    Layout = "~/Views/Layout/AdminLayout.cshtml";
    var permissions = (IEnumerable<Quyen>)ViewBag.MaQuyen;
    var assigned = (IEnumerable<LoaiThanhVien_Quyen>)ViewBag.LoaiTVQuyen;
    var selected = new HashSet<string>(assigned.Select(role => role.MaQuyen), StringComparer.OrdinalIgnoreCase);
}

<h4>@Html.ActionLink("Phân quyền thành viên", "Index") &gt; Phân quyền</h4>
<div class="card">
    <div class="card-body">
        <h2>Loại thành viên: @Model.TenLoai</h2>
        @using (Html.BeginForm("PhanQuyen", "PhanQuyen", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(false, "", new { @class = "text-danger" })
            @Html.Hidden("MaLTV", Model.MaLoaiTV)
            <div class="row">
                @foreach (var permission in permissions)
                {
                    <label class="col-md-4" style="font-size:15pt;">
                        <input type="checkbox" style="height:1em;width:1em;"
                               name="selectedPermissions" value="@permission.MaQuyen"
                               checked="@(selected.Contains(permission.MaQuyen) ? "checked" : null)" />
                        @(string.IsNullOrWhiteSpace(permission.TenQuyen) ? permission.MaQuyen : permission.TenQuyen)
                    </label>
                }
            </div>
            <div class="form-group row mt-3">
                <div class="col-sm-4">
                    <input type="submit" value="Thực hiện" class="btn btn-sm btn-primary font-weight-bold w-25" />
                    @Html.ActionLink("Trở về", "Index", null, htmlAttributes: new { @class = "btn btn-sm btn-secondary font-weight-bold w-25" })
                </div>
            </div>
        }
    </div>
</div>
