@using WebsiteBanHang.Models
@using PagedList.Mvc
@model PagedList.IPagedList<SanPham>
@{
    ViewBag.Title = "Danh Mục Sản Phẩm";
    string tenLoai = Model != null && Model.Any() && Model.First().LoaiSanPham != null ? Model.First().LoaiSanPham.TenLoai : "Sản phẩm";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")"><i class="fas fa-home me-1"></i>Trang chủ</a></li>
        <li class="breadcrumb-item active">@tenLoai</li>
    </ol>
</nav>

<!-- Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-700 mb-1">@tenLoai</h4>
        <p class="text-muted small mb-0">Tìm thấy @Model.TotalItemCount sản phẩm</p>
    </div>
</div>

<!-- Grid sản phẩm -->
<div class="row g-4">
    @foreach (var item in Model) {
        <div class="col-6 col-md-4">
            <div class="moto-card">
                <div class="moto-card-img-wrap">
                    <a href="@Url.RouteUrl("XemChiTiet", new { @id = item.MaSP, @tensp = item.TenSP })">
                        <img src="@Url.Content("~/Content/HinhAnhSP/" + item.HinhAnh)" alt="@item.TenSP" />
                    </a>
                    @if (item.Moi == 1) {
                        <span class="badge-new">Mới</span>
                    }
                </div>
                <div class="moto-card-body">
                    <p class="card-brand">@(item.NhaSanXuat != null ? item.NhaSanXuat.TenNSX : "Chính hãng")</p>
                    <h6 class="card-name">
                        <a href="@Url.RouteUrl("XemChiTiet", new { @id = item.MaSP, @tensp = item.TenSP })">@item.TenSP</a>
                    </h6>
                    <div class="card-price-row">
                        <span class="card-price">@item.DonGia.Value.ToString("#,##") <small>VNĐ</small></span>
                    </div>
                    <div class="card-actions">
                        <a href="@Url.RouteUrl("XemChiTiet", new { @id = item.MaSP, @tensp = item.TenSP })"
                           class="btn-card-detail flex-grow-1">
                            <i class="fas fa-eye me-1"></i>Chi tiết
                        </a>
                        @if (Session["TaiKhoan"] != null)
                        {
                            <a href="javascript:void(0);"
                               class="btn-card-cart add-to-cart"
                               data-id="@item.MaSP">
                                <i class="fas fa-shopping-cart"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Pagination -->
@if (Model.PageCount > 1) {
    <div class="d-flex align-items-center justify-content-between mt-5 pt-4 border-top">
        <p class="text-muted small mb-0">Trang <strong>@Model.PageNumber</strong> / @Model.PageCount</p>
        <div class="moto-pager">
            @Html.PagedListPager(Model, page => Url.Action("LoaiSanPham", new { page = page, MaLoaiSP = ViewBag.MaLoaiSP }),
                new PagedListRenderOptions {
                    LinkToPreviousPageFormat = "<i class='fas fa-chevron-left'></i>",
                    LinkToNextPageFormat = "<i class='fas fa-chevron-right'></i>",
                    MaximumPageNumbersToDisplay = 5
                })
        </div>
    </div>
}
