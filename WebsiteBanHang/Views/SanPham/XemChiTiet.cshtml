@model WebsiteBanHang.Models.SanPham
@{
    ViewBag.Title = Model.TenSP;
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")"><i class="fas fa-home me-1"></i>Trang chủ</a></li>
        <li class="breadcrumb-item">
            <a href="@Url.Action("LoaiSanPham","SanPham", new { MaLoaiSP = Model.MaLoaiSP })">@(Model.LoaiSanPham != null ? Model.LoaiSanPham.TenLoai : "Xe máy")</a>
        </li>
        <li class="breadcrumb-item active">@Model.TenSP</li>
    </ol>
</nav>

<!-- Product Detail -->
<div class="row g-5 mb-5">
    <!-- Hình ảnh bên trái -->
    <div class="col-md-5">
        <div class="product-gallery">
            <!-- Ảnh chính -->
            <div class="product-main-img mb-3">
                <img id="mainImg"
                     src="@Url.Content("~/Content/HinhAnhSP/" + Model.HinhAnh1)"
                     alt="@Model.TenSP"
                     class="img-fluid rounded-3"
                     style="width:100%;object-fit:cover;max-height:380px;cursor:zoom-in;" />
            </div>
            <!-- Thumbnails -->
            <div class="d-flex gap-2 flex-wrap">
                @{
                    var thumbs = new[] { Model.HinhAnh1, Model.HinhAnh2, Model.HinhAnh3, Model.HinhAnh4 };
                    foreach (var t in thumbs) {
                        if (!string.IsNullOrEmpty(t)) {
                            <img src="@Url.Content("~/Content/HinhAnhSP/" + t)"
                                 alt=""
                                 class="product-thumb rounded-2"
                                 onclick="document.getElementById('mainImg').src=this.src"
                                 style="width:72px;height:72px;object-fit:cover;cursor:pointer;border:2px solid #dee2e6;border-radius:8px;" />
                        }
                    }
                }
            </div>
        </div>
    </div>

    <!-- Thông tin bên phải -->
    <div class="col-md-7">
        <div class="product-detail-info">
            <!-- Brand tag -->
            <span class="product-brand-tag">
                <i class="fas fa-tag me-1"></i>@(Model.NhaSanXuat != null ? Model.NhaSanXuat.TenNSX : "Chính hãng")
            </span>

            <h2 class="product-title mt-2 mb-3">@Model.TenSP</h2>

            <!-- Rating dạng tĩnh -->
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="product-stars">
                    <i class="fas fa-star text-warning"></i>
                    <i class="fas fa-star text-warning"></i>
                    <i class="fas fa-star text-warning"></i>
                    <i class="fas fa-star text-warning"></i>
                    <i class="far fa-star text-warning"></i>
                </div>
                <span class="text-muted small">
                    <i class="fas fa-eye me-1"></i>@Model.LuotXem lượt xem
                </span>
            </div>

            <!-- Giá -->
            <div class="product-price-box mb-4">
                <span class="product-price-label">Giá bán:</span>
                <span class="product-price-value">@Model.DonGia.Value.ToString("#,##") <span>VNĐ</span></span>
            </div>

            <!-- Giới thiệu summary -->
            <div class="product-intro mb-4">
                <p class="text-muted mb-2" style="font-size:.875rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;">Giới thiệu</p>
                <div style="font-size:.9rem;color:#4a4a4a;line-height:1.7;">
                    @Html.Raw(Model.DongCo)
                </div>
            </div>

            <hr />

            <!-- Nút hành động -->
            <div class="d-flex gap-3 mt-4">
                @if (Session["TaiKhoan"] != null)
                {
                    <a href="javascript:void(0);"
                       class="btn-add-cart add-to-cart"
                       data-id="@Model.MaSP">
                        <i class="fas fa-shopping-cart me-2"></i>Thêm vào giỏ hàng
                    </a>
                }
                <a href="@Url.Action("LoaiSanPham","SanPham", new { MaLoaiSP = Model.MaLoaiSP != null ? Model.MaLoaiSP : 0 })"
                   class="btn-back-list">
                    <i class="fas fa-arrow-left me-2"></i>Quay lại
                </a>
            </div>

            <!-- Thẻ thông tin nhanh -->
            <div class="product-meta-tags mt-4">
                <span><i class="fas fa-shield-alt me-1"></i>Bảo hành chính hãng</span>
                <span><i class="fas fa-shipping-fast me-1"></i>Giao xe tận nơi</span>
                <span><i class="fas fa-redo me-1"></i>Đổi trả 30 ngày</span>
            </div>
        </div>
    </div>
</div>

<!-- Tabs mô tả chi tiết -->
<div class="product-tabs mb-5">
    <ul class="nav nav-tabs product-nav-tabs" id="productTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="mota-tab" data-bs-toggle="tab" data-bs-target="#mota" type="button">
                <i class="fas fa-file-alt me-2"></i>Mô tả sản phẩm
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="thongso-tab" data-bs-toggle="tab" data-bs-target="#thongso" type="button">
                <i class="fas fa-cogs me-2"></i>Thông số kỹ thuật
            </button>
        </li>
    </ul>
    <div class="tab-content product-tab-content" id="productTabContent">
        <div class="tab-pane fade show active" id="mota" role="tabpanel">
            <div class="product-description">
                @Html.Raw(Model.MoTa)
            </div>
        </div>
        <div class="tab-pane fade" id="thongso" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-bordered align-middle" style="font-size:.9rem;">
                    <tbody>
                        <tr><th style="width:35%;background:#f8f9fa;">Hãng sản xuất</th><td>@(Model.NhaSanXuat != null ? Model.NhaSanXuat.TenNSX : "Chính hãng")</td></tr>
                        <tr><th style="background:#f8f9fa;">Dòng xe</th><td>@(Model.LoaiSanPham != null ? Model.LoaiSanPham.TenLoai : "Xe máy")</td></tr>
                        <tr><th style="background:#f8f9fa;">Màu sắc</th><td>Xanh, Đen, Đỏ, Trắng</td></tr>
                        <tr><th style="background:#f8f9fa;">Phân khối</th><td>50cc, 110cc, 125cc, 150cc</td></tr>
                        <tr><th style="background:#f8f9fa;">Giá bán</th><td><strong>@Model.DonGia.Value.ToString("#,##") VNĐ</strong></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
