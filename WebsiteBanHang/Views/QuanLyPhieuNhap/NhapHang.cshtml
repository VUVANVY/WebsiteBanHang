@using WebsiteBanHang.Models
@model PhieuNhap
@{
    ViewBag.Title = "Lập phiếu nhập hàng";
    Layout = "~/Views/Layout/AdminLayout.cshtml";
    var products = (IEnumerable<SanPham>)ViewBag.ListSanPham;
    var lines = (IList<ChiTietPhieuNhap>)ViewBag.ChiTietNhap;
}

<h2>@ViewBag.Title</h2>
<div class="card shadow-sm">
    <div class="card-body">
        @using (Html.BeginForm("NhapHang", "QuanLyPhieuNhap", FormMethod.Post, new { id = "import-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(false, "", new { @class = "text-danger" })
            <div class="form-group">
                <label for="MaNCC">Nhà cung cấp</label>
                @Html.DropDownList("MaNCC", (SelectList)ViewBag.MaNCC, "-- Chọn nhà cung cấp --", new { @class = "form-control", required = "required" })
            </div>
            <div class="table-responsive">
                <table class="table table-bordered" id="import-lines">
                    <thead><tr><th>Sản phẩm</th><th>Đơn giá nhập (VNĐ)</th><th>Số lượng nhập</th><th></th></tr></thead>
                    <tbody>
                        @for (int i = 0; i < lines.Count; i++)
                        {
                            <tr>
                                <td>@Html.DropDownList("lstModel[" + i + "].MaSP", new SelectList(products, "MaSP", "TenSP", lines[i].MaSP), "-- Chọn sản phẩm --", new { @class = "form-control", data_field = "MaSP", required = "required" })</td>
                                <td>@Html.TextBox("lstModel[" + i + "].DonGiaNhap", lines[i].DonGiaNhap ?? 0, new { @class = "form-control", type = "number", min = "0", step = "1", data_field = "DonGiaNhap", required = "required" })</td>
                                <td>@Html.TextBox("lstModel[" + i + "].SoLuongNhap", lines[i].SoLuongNhap ?? 1, new { @class = "form-control", type = "number", min = "1", step = "1", data_field = "SoLuongNhap", required = "required" })</td>
                                <td><button type="button" class="btn btn-outline-danger remove-import-line" aria-label="Xóa dòng">Xóa</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <button type="button" class="btn btn-outline-primary" id="add-import-line">Thêm sản phẩm</button>
            <button type="submit" class="btn btn-primary">Lưu phiếu nhập</button>
            <a class="btn btn-secondary" href="@Url.Action("DSSPHetHang")">Trở về</a>
        }
    </div>
</div>
<script>
    (function () {
        var body = document.querySelector('#import-lines tbody');
        var template = body.rows[0].cloneNode(true);
        function reindex() {
            Array.prototype.forEach.call(body.rows, function (row, index) {
                row.querySelectorAll('[data-field]').forEach(function (field) {
                    field.name = 'lstModel[' + index + '].' + field.getAttribute('data-field');
                    field.removeAttribute('id');
                });
            });
        }
        document.getElementById('add-import-line').addEventListener('click', function () {
            var row = template.cloneNode(true);
            row.querySelector('[data-field="MaSP"]').selectedIndex = 0;
            row.querySelector('[data-field="DonGiaNhap"]').value = '0';
            row.querySelector('[data-field="SoLuongNhap"]').value = '1';
            body.appendChild(row);
            reindex();
        });
        body.addEventListener('click', function (event) {
            if (!event.target.classList.contains('remove-import-line')) return;
            if (body.rows.length > 1) event.target.closest('tr').remove();
            reindex();
        });
        document.getElementById('import-form').addEventListener('submit', reindex);
    })();
</script>
