@model IEnumerable<WebsiteBanHang.Models.DonDatHang>
@{
    ViewBag.Title = "Đơn hàng của tôi";
}
<div class="mb-3">
    <a href="@Url.Action("Index")" class="btn btn-outline-dark btn-sm">Tất cả</a>
    <a href="@Url.Action("Index", new { trangThai="chuatt"})"
       class="btn btn-outline-warning btn-sm">Chưa thanh toán</a>
    <a href="@Url.Action("Index", new { trangThai="hoanthanh"})"
       class="btn btn-outline-success btn-sm">Hoàn thành</a>
</div>
<div class="container py-5">
    <h3 class="fw-bold mb-4">
        <i class="fas fa-box me-2 text-primary"></i>
        Đơn hàng của tôi
    </h3>

    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-hover align-middle text-center">
                <thead class="table-light">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Ngày đặt</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.MaDDH</td>
                            <td>
                                @(item.NgayDat.HasValue
                                  ? item.NgayDat.Value.ToString("dd/MM/yyyy")
                                  : "")
                            </td>

                            <td>
                                @{
                                    string status = "";
                                    string badge = "bg-secondary";

                                    if (item.DaHuy == true)
                                    {
                                        status = "Đã hủy";
                                        badge = "bg-danger";
                                    }
                                    else if (item.DaThanhToan == false)
                                    {
                                        status = "Chưa thanh toán";
                                        badge = "bg-warning text-dark";
                                    }
                                    else if (item.TinhTrangGiaoHang == false)
                                    {
                                        status = "Đang xử lý";
                                        badge = "bg-primary";
                                    }
                                    else
                                    {
                                        status = "Hoàn thành";
                                        badge = "bg-success";
                                    }
                                }

                                <span class="badge @badge px-3 py-2">
                                    @status
                                </span>
                            </td>

                            <td>
                                <a href="@Url.Action("ChiTiet", "DonHang", new { id = item.MaDDH })"
                                   class="btn btn-dark btn-sm">
                                    Xem chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>
