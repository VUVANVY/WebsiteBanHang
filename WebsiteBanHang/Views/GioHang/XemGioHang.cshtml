@using WebsiteBanHang.Models
@model List<ItemGioHang>

@{
    ViewBag.Title = "XemGioHang";
    Layout = "~/Views/Layout/RegisterLayout.cshtml";
}

@if (Model == null && Model.Count == 0) //nếu list giỏ hàng rỗng thì xuất thông báo
{
    <h1 style="color:crimson">Giỏ hàng rỗng</h1>
}
else
{

<div class="moto-cart-page py-5 bg-light min-vh-100">
    <div class="container">
        <!-- Header -->
        <div class="d-flex align-items-center gap-3 mb-5">
            <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                <i class="fas fa-shopping-basket fa-lg"></i>
            </div>
            <div>
                <h2 class="fw-800 mb-0">Giỏ hàng của bạn</h2>
                <p class="text-muted mb-0">Bạn đang có <span class="fw-bold text-dark">@ViewBag.TongSoLuong</span> sản phẩm trong giỏ</p>
            </div>
        </div>

        @using (Html.BeginForm("DatHang", "GioHang", FormMethod.Post, new { @id = "myform" }))
        {
            <div class="row g-4">
                <!-- Cột trái: Danh sách sản phẩm + Thông tin khách hàng -->
                <div class="col-lg-8">
                    
                    <!-- Form thông tin khách hàng (nếu chưa đăng nhập) -->
                    @if (Session["TaiKhoan"] == null)
                    {
                        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                            <div class="card-header bg-white border-bottom py-3 px-4">
                                <h5 class="mb-0 fw-700 text-dark"><i class="fas fa-user-edit me-2 text-secondary"></i>Thông tin mua hàng</h5>
                            </div>
                            <div class="card-body p-4 text-start">
                                @Html.Hidden("MaThanhVien", 1)
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-uppercase opacity-75">Tên khách hàng</label>
                                        @Html.TextBox("TenKH", null, new { @class = "form-control rounded-3", placeholder = "Nhập họ tên của bạn", required = "required" })
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-uppercase opacity-75">Số điện thoại</label>
                                        @Html.TextBox("SoDienThoai", null, new { @class = "form-control rounded-3", placeholder = "0xxx xxx xxx", required = "required" })
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label small fw-bold text-uppercase opacity-75">Email nhận tin (không bắt buộc)</label>
                                        @Html.TextBox("Email", null, new { @class = "form-control rounded-3", placeholder = "example@gmail.com" })
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label small fw-bold text-uppercase opacity-75">Địa chỉ giao xe</label>
                                        @Html.TextArea("DiaChi", null, new { @class = "form-control rounded-3", rows = "2", placeholder = "Số nhà, tên đường, phường/xã..." })
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Danh sách sản phẩm -->
                    <div class="cart-items-wrapper">
                        @foreach (var item in Model)
                        {
                            <div class="card border-0 shadow-sm rounded-4 mb-3 position-relative overflow-hidden moto-item-card text-start">
                                <div class="card-body p-3">
                                    <div class="row align-items-center g-3">
                                        <!-- Hình ảnh -->
                                        <div class="col-4 col-md-2 text-center">
                                            <div class="rounded-3 bg-light overflow-hidden" style="aspect-ratio: 1; display: flex; align-items: center; justify-content: center;">
                                                <img src="@Url.Content("~/Content/HinhAnhSP/" + item.HinhAnh)" class="img-fluid" style="max-height: 80px; object-fit: contain;" alt="@item.TenSP" />
                                            </div>
                                        </div>
                                        <!-- Thông tin -->
                                        <div class="col-8 col-md-5">
                                            <h6 class="fw-700 text-dark mb-1">@item.TenSP</h6>
                                            <p class="text-muted small mb-0">Sản phẩm chính hãng</p>
                                        </div>
                                        <!-- Số lượng & Giá -->
                                        <div class="col-12 col-md-5">
                                            <div class="d-flex align-items-center justify-content-between justify-content-md-end gap-md-4">
                                                <div class="text-md-center">
                                                    <span class="d-block small text-muted">Số lượng</span>
                                                    <span class="fw-bold">@item.SoLuong</span>
                                                </div>
                                                <div class="text-md-end">
                                                    <span class="d-block small text-muted">Thành tiền</span>
                                                    <span class="fw-bold text-dark fs-5">@item.ThanhTien.ToString("#,##") <small>đ</small></span>
                                                </div>
                                                <div class="actions ms-2">
                                                    <div class="d-flex flex-column gap-2">
                                                        <a href="@Url.Action("SuaGioHang", new { @MaSP = item.MaSP })" class="btn btn-sm btn-light rounded-circle p-2" title="Sửa">
                                                            <i class="fas fa-edit text-primary"></i>
                                                        </a>
                                                        <a href="@Url.Action("XoaGioHang", new { @MaSP = item.MaSP })" class="btn btn-sm btn-light rounded-circle p-2" title="Xóa">
                                                            <i class="fas fa-times text-danger"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Cột phải: Tổng kết -->
                <div class="col-lg-4">
                    <div class="sticky-top" style="top: 100px; z-index: 10;">
                        <div class="card border-0 shadow rounded-4 overflow-hidden mb-4">
                            <div class="card-body p-4 text-start">
                                <h5 class="fw-800 mb-4 pb-2 border-bottom">Tóm tắt đơn hàng</h5>
                                
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Tạm tính (@ViewBag.TongSoLuong sản phẩm)</span>
                                    <span class="fw-600">@ViewBag.TongTien.ToString("#,##") đ</span>
                                </div>
                                <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                                    <span class="text-muted">Phí vận chuyển</span>
                                    <span class="text-success fw-bold">Miễn phí</span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <span class="fs-5 fw-800">Tổng cộng</span>
                                    <div class="text-end">
                                        <span class="fs-3 fw-800 text-dark">@ViewBag.TongTien.ToString("#,##") <small class="fs-6">đ</small></span>
                                        <p class="text-muted small mb-0">(Đã bao gồm VAT)</p>
                                    </div>
                                </div>

                                <button type="button" onclick="document.forms['myform'].submit();" class="btn btn-dark w-100 py-3 rounded-pill fw-bold fs-5 shadow-sm mb-3">
                                    XÁC NHẬN ĐẶT HÀNG <i class="fas fa-arrow-right ms-2"></i>
                                </button>
                                
                                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary w-100 py-2 rounded-pill fw-600">
                                    <i class="fas fa-reply me-2"></i>Tiếp tục mua hàng
                                </a>
                            </div>
                        </div>

                        <!-- Badge an tâm -->
                        <div class="card bg-white border-0 shadow-sm rounded-4 p-3 mb-4">
                            <div class="d-flex align-items-center gap-3">
                                <i class="fas fa-shield-alt fa-2x text-success opacity-75"></i>
                                <div class="text-start">
                                    <p class="mb-0 fw-bold small text-dark">Cam kết chính hãng 100%</p>
                                    <p class="mb-0 text-muted smaller" style="font-size: 0.75rem;">Đổi trả linh hoạt nếu phát hiện lỗi từ nhà sản xuất</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .smaller { font-size: 0.8rem; }
    .moto-item-card { transition: transform 0.2s, box-shadow 0.2s; }
    .moto-item-card:hover { transform: translateX(5px); box-shadow: 0 5px 15px rgba(0,0,0,0.08) !important; }
    .fw-800 { font-weight: 800; }
    .smaller { font-size: 0.75rem; }
</style>
}


