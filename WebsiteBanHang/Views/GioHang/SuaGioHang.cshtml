@using WebsiteBanHang.Models
@model ItemGioHang
@{
    ViewBag.Title = "Sửa giỏ hàng";
    Layout = "~/Views/Layout/RegisterLayout.cshtml";
    var cart = ViewBag.GioHang as List<ItemGioHang> ?? new List<ItemGioHang>();
}

<div class="container py-5">
    <h2 class="mb-4">Cập nhật giỏ hàng</h2>
    @foreach (var item in cart)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-3">
            <div class="card-body">
                @using (Html.BeginForm("CapNhatGioHang", "GioHang", FormMethod.Post, new { @class = "row align-items-center g-3" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="MaSP" value="@item.MaSP" />
                    <div class="col-3 col-md-2">
                        <img src="@Url.Content("~/Content/HinhAnhSP/" + item.HinhAnh)" class="img-fluid" style="max-height:100px" alt="@item.TenSP" />
                    </div>
                    <div class="col-9 col-md-4">
                        <h5>@item.TenSP</h5>
                        <div>Đơn giá: @item.DonGia.ToString("N0") đ</div>
                        <div>Thành tiền: @item.ThanhTien.ToString("N0") đ</div>
                    </div>
                    <div class="col-5 col-md-2">
                        <label for="quantity-@item.MaSP" class="form-label">Số lượng</label>
                        @Html.TextBox("SoLuong", item.SoLuong, new { id = "quantity-" + item.MaSP, type = "number", min = "1", step = "1", required = "required", @class = "form-control" })
                    </div>
                    <div class="col-7 col-md-4 text-end">
                        <button type="submit" class="btn btn-dark">Cập nhật</button>
                        <button type="submit" formaction="@Url.Action("XoaGioHang", new { MaSP = item.MaSP })" formmethod="post" formnovalidate class="btn btn-outline-danger">Xóa</button>
                    </div>
                }
            </div>
        </div>
    }
    <a href="@Url.Action("XemGioHang")" class="btn btn-outline-secondary mt-3">Quay lại giỏ hàng</a>
</div>
