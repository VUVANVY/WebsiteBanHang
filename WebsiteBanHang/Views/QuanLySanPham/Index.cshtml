@using WebsiteBanHang.Models
@model IEnumerable<SanPham>

@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Views/Layout/AdminLayout.cshtml";
    WebGrid grid = new WebGrid(
        source: Model,
        rowsPerPage: 10,
        canPage: true,
        canSort: true
    );
}

@if (TempData["Success"] != null)
{
    <div id="autoAlert" class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div id="autoAlert" class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="fas fa-box-open text-primary me-2"></i>
                Quản lý sản phẩm
            </h3>
            <small class="text-muted">
                Danh sách sản phẩm trong hệ thống
            </small>
        </div>

        <a href="@Url.Action("TaoMoi")"
           class="btn btn-warning px-4 shadow-sm">
            <i class="fas fa-plus me-1"></i> Thêm mới
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body">

            <div class="row mb-3 align-items-center">
                <div class="col-md-6">
                    <span class="fw-semibold">
                        Tổng:
                        <span class="text-primary fs-5">
                            @Model.Count()
                        </span> sản phẩm
                    </span>
                </div>
            </div>

            <div class="table-responsive">

                @grid.GetHtml(
                    tableStyle: "table table-hover align-middle table-bordered text-center",
                    headerStyle: "table-light fw-bold",
                    footerStyle: "text-center",
                    numericLinksCount: 5,
                    mode: WebGridPagerModes.All,
                    firstText: "Trang đầu",
                    previousText: "«",
                    nextText: "»",
                    lastText: "Trang cuối",
                    columns: grid.Columns(

                        grid.Column("MaSP", "Mã"),

                        grid.Column("TenSP", "Tên sản phẩm"),

                        grid.Column("HinhAnh", "Hình ảnh", format: item =>
                            item.HinhAnh != null
                                ? Html.Raw("<img src='/Content/HinhAnhSP/" + item.HinhAnh +
                                    "' style='width:80px;height:80px;object-fit:cover;border-radius:8px;' />")
                                : Html.Raw("<span class='text-muted'>Chưa có</span>")
                        ),

                        grid.Column("SoLuongTon", "Tồn kho", format: item =>
                        {
                            int sl = item.SoLuongTon ?? 0;

                            if (sl > 10)
                                return Html.Raw("<span class='badge bg-success'>" + sl + "</span>");
                            else if (sl > 0)
                                return Html.Raw("<span class='badge bg-warning text-dark'>" + sl + "</span>");
                            else
                                return Html.Raw("<span class='badge bg-danger'>Hết hàng</span>");
                        }),

                        grid.Column("DonGia", "Đơn giá", format: item =>
                            Html.Raw("<span class='text-primary fw-bold'>" +
                                String.Format("{0:#,##} đ", item.DonGia ?? 0) +
                                "</span>")
                        ),

                        // LOẠI
                        grid.Column("Loại", format: item =>
                            item.LoaiSanPham != null
                                ? item.LoaiSanPham.TenLoai
                                : ""
                        ),

                        // NSX
                        grid.Column("NSX", format: item =>
                            item.NhaSanXuat != null
                                ? item.NhaSanXuat.TenNSX
                                : ""
                        ),

                        grid.Column("Thao tác", format: item => Html.Raw(
                            "<a href='/QuanLySanPham/ChinhSua/" + item.MaSP +
                            "' class='btn btn-sm btn-outline-primary me-1'><i class='fas fa-edit'></i></a>" +

                            "<form action='/QuanLySanPham/Xoa/" + item.MaSP +
                            "' method='post' style='display:inline;' onsubmit='return confirm(\"Bạn có chắc muốn xóa?\")'>" +
                            "<button type='submit' class='btn btn-sm btn-outline-danger me-1'>" +
                            "<i class='fas fa-trash'></i></button></form>" +

                            "<a href='/QuanLySanPham/UploadHinh/" + item.MaSP +
                            "' class='btn btn-sm btn-outline-secondary'>" +
                            "<i class='fas fa-image'></i></a>"
                        ))

                    )
                )

            </div>

        </div>
    </div>

</div>

<script>
    setTimeout(function () {
        var alert = document.getElementById("autoAlert");
        if (alert) {
            alert.style.transition = "opacity 0.5s";
            alert.style.opacity = "0";
            setTimeout(function () {
                alert.remove();
            }, 500);
        }
    }, 2000);
</script>