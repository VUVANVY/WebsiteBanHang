@using WebsiteBanHang.Models
@model IEnumerable<SanPham>

<div class="header-vertical-menu" id="mainMenuNav">
    <ul class="nav flex-column me-auto">
        <li class="nav-item">
            <a class="nav-link" href="@Url.Action("Index","Home")">
                <i class="fas fa-home me-1"></i>Trang chủ
            </a>
        </li>

        @foreach (var groupItem in Model.GroupBy(n => n.LoaiSanPham)) {
            if (groupItem.Key != null) {
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="@Url.Action("LoaiSanPham","SanPham",new { MaLoaiSP = groupItem.Key.MaLoaiSP })"
                       data-bs-toggle="dropdown" role="button">
                        @groupItem.Key.TenLoai
                    </a>
                    <ul class="dropdown-menu">
                        <li><h6 class="dropdown-header">@groupItem.Key.TenLoai theo hãng</h6></li>
                        <li><a class="dropdown-item" href="@Url.Action("LoaiSanPham","SanPham",new { MaLoaiSP = groupItem.Key.MaLoaiSP })">
                            <i class="fas fa-layer-group me-2 text-secondary"></i>Tất cả @groupItem.Key.TenLoai
                        </a></li>
                        <li><hr class="dropdown-divider"></li>
                        @{
                            foreach (var item in groupItem.GroupBy(n => n.NhaSanXuat)) {
                                if (item.Key != null) {
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("SanPham","SanPham",new { MaLoaiSP = groupItem.Key.MaLoaiSP, MaNSX = item.Key.MaNSX })">
                                            <i class="fas fa-chevron-right me-2 text-secondary" style="font-size:.7rem;"></i>@item.Key.TenNSX
                                        </a>
                                    </li>
                                }
                            }
                        }
                    </ul>
                </li>
            }
        }

        <!-- Thương Hiệu mega dropdown -->
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" role="button">
                <i class="fas fa-tag me-1"></i>Thương Hiệu
            </a>
            <ul class="dropdown-menu">
                @{
                    <li><hr class="dropdown-divider"></li>
                    <li><h6 class="dropdown-header text-dark fw-bold px-3 py-2"><i class="fas fa-motorcycle me-2"></i>TẤT CẢ THƯƠNG HIỆU</h6></li>
                    <div class="row g-0 px-2 pb-2">
                        @foreach (var groupNSX in Model.GroupBy(n => n.NhaSanXuat)) {
                            if (groupNSX.Key != null) {
                                <div class="col-6">
                                    <a class="dropdown-item py-2" href="@Url.Action("SanPham","SanPham", new { MaNSX = groupNSX.Key.MaNSX })">
                                        <i class="fas fa-check-circle me-1 text-primary" style="font-size:.7rem;"></i>@groupNSX.Key.TenNSX
                                    </a>
                                </div>
                            }
                        }
                    </div>
                }
            </ul>
        </li>
    </ul>
</div>