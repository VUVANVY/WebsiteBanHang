@using CaptchaMvc.HtmlHelpers
@using CaptchaMvc
@model WebsiteBanHang.Models.ThanhVien
@{
    ViewBag.Title = "Đăng ký thành viên";
    Layout = "~/Views/Layout/RegisterLayout.cshtml";
}

<div class="moto-auth-section">
    <div class="moto-auth-card" style="max-width:680px;">
        <div class="d-flex align-items-center gap-3 mb-4">
            <div style="width:44px;height:44px;background:#f8f9fa;border:1px solid #dee2e6;border-radius:10px;display:flex;align-items:center;justify-content:center;">
                <i class="fas fa-user-plus text-secondary"></i>
            </div>
            <div>
                <h2 class="mb-0">Đăng ký tài khoản</h2>
                <p class="auth-subtitle mb-0">Tạo tài khoản để mua sắm dễ dàng hơn</p>
            </div>
        </div>

        @if (ViewBag.ThongBao != null) {
            <div class="alert alert-success border-0 rounded-3 py-2 px-3 mb-3" style="background:#f0fdf4;color:#166534;font-size:.875rem;">
                <i class="fas fa-check-circle me-2"></i>@ViewBag.ThongBao
            </div>
        }

        @using (Html.BeginForm()) {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger", style = "font-size:.8rem;" })

            <div class="row g-4">
                <!-- Thông tin cá nhân -->
                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                        <i class="fas fa-id-card text-secondary"></i>
                        <span style="font-size:.8rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#6c757d;">Thông tin cá nhân</span>
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(model => model.HoTen, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.HoTen, new { @class = "form-control", placeholder = "Nhập họ và tên" })
                        @Html.ValidationMessageFor(model => model.HoTen, "", new { @class = "text-danger", style = "font-size:.78rem;" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(model => model.DiaChi, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.DiaChi, new { @class = "form-control", placeholder = "Địa chỉ của bạn" })
                        @Html.ValidationMessageFor(model => model.DiaChi, "", new { @class = "text-danger", style = "font-size:.78rem;" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(model => model.Email, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.Email, new { @class = "form-control", placeholder = "email@example.com" })
                        @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger", style = "font-size:.78rem;" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(model => model.SoDienThoai, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.SoDienThoai, new { @class = "form-control", placeholder = "0xxx xxx xxx" })
                        @Html.ValidationMessageFor(model => model.SoDienThoai, "", new { @class = "text-danger", style = "font-size:.78rem;" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(model => model.CauHoi, new { @class = "form-label" })
                        @Html.DropDownList("CauHoi", null, new { @class = "form-control" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(model => model.CauTraLoi, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.CauTraLoi, new { @class = "form-control", placeholder = "Câu trả lời bảo mật" })
                        @Html.ValidationMessageFor(model => model.CauTraLoi, "", new { @class = "text-danger", style = "font-size:.78rem;" })
                    </div>
                </div>

                <!-- Thông tin đăng nhập -->
                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                        <i class="fas fa-lock text-secondary"></i>
                        <span style="font-size:.8rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#6c757d;">Thông tin đăng nhập</span>
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(model => model.TaiKhoan, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.TaiKhoan, new { @class = "form-control", placeholder = "Tên đăng nhập" })
                        @Html.ValidationMessageFor(model => model.TaiKhoan, "", new { @class = "text-danger", style = "font-size:.78rem;" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(model => model.MatKhau, new { @class = "form-label" })
                        @Html.PasswordFor(model => model.MatKhau, new { @class = "form-control", placeholder = "Mật khẩu (tối thiểu 6 ký tự)" })
                        @Html.ValidationMessageFor(model => model.MatKhau, "", new { @class = "text-danger", style = "font-size:.78rem;" })
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Nhập lại mật khẩu</label>
                        @Html.Password("NhapLaiMatKhau", null, new { @class = "form-control", placeholder = "Xác nhận mật khẩu" })
                    </div>

                    <div class="mb-4">
                        @Html.Captcha(5)
                    </div>

                    <button type="submit" class="btn-submit">
                        <i class="fas fa-user-plus me-2"></i>Tạo tài khoản
                    </button>

                    <p class="text-center mt-3" style="font-size:.875rem;color:#6c757d;">
                        Đã có tài khoản?
                        <a href="@Url.Action("Index","Home")" class="text-dark fw-semibold">Đăng nhập</a>
                    </p>
                </div>
            </div>
        }
    </div>
</div>
