@using WebsiteBanHang.Models
@using PagedList.Mvc
@model PagedList.IPagedList<SanPham>
@{
    ViewBag.Title = "Kết quả tìm kiếm";
}

<style>
    .bottom-product .bottom-cd .tun {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>
@if (ViewBag.ThongBao != null)
{
    <div class="text-center py-5">
        <i class="fas fa-search fa-2x mb-3 text-muted"></i>
        <p class="fw-semibold">@ViewBag.ThongBao</p>
    </div>
}
<div class="moto-section mb-5">

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <div class="moto-card">
                    <div class="moto-card-img-wrap">
                        <a href="@Url.RouteUrl("XemChiTiet", new { id = item.MaSP, tensp = item.TenSP })">
                            <img src="@Url.Content("~/Content/HinhAnhSP/" + item.HinhAnh)"
                                 alt="@item.TenSP" />
                        </a>
                        @if (item.Moi == 1)
                        {
                            <span class="badge-new">Mới</span>
                        }
                    </div>

                    <div class="moto-card-body">
                        <p class="card-brand">
                            @(item.NhaSanXuat != null ? item.NhaSanXuat.TenNSX : "Chính hãng")
                        </p>

                        <h6 class="card-name">
                            <a href="@Url.RouteUrl("XemChiTiet", new { id = item.MaSP, tensp = item.TenSP })">
                                @item.TenSP
                            </a>
                        </h6>

                        <div class="card-price-row">
                            <span class="card-price">
                                @item.DonGia.Value.ToString("#,##") <small>VNĐ</small>
                            </span>
                        </div>

                        <div class="card-actions">
                            <a href="@Url.RouteUrl("XemChiTiet", new { id = item.MaSP, tensp = item.TenSP })"
                               class="btn-card-detail">
                                <i class="fas fa-eye me-1"></i>Chi tiết
                            </a>

                            @if (Session["TaiKhoan"] != null)
                            {
                                <a href="javascript:void(0);"
                                   class="btn-card-cart add-to-cart"
                                   data-id="@item.MaSP">
                                    <i class="fas fa-shopping-cart"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex align-items-center justify-content-between mt-5 pt-4 border-top">

        <p class="text-muted small mb-0">
            Trang @(Model.PageNumber)/@Model.PageCount
        </p>

        <nav>
            @Html.PagedListPager(
    Model,
    page => Url.Action("KQTimKiem", "TimKiem",
        new { page = page, sTuKhoa = Request.QueryString["sTuKhoa"] })
)
        </nav>

    </div>

    <script>
    setTimeout(function () {
        var alertBox = document.getElementById("searchAlert");
        if (alertBox) {
            alertBox.style.transition = "all 0.5s";
            alertBox.style.opacity = "0";
            alertBox.style.transform = "translateY(-10px)";

            setTimeout(function () {
                alertBox.remove();
            }, 500);
        }
    }, 2000);
    </script>

</div>