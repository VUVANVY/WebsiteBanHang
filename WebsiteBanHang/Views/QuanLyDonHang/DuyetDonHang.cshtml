@model WebsiteBanHang.Models.DonDatHang
@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Layout/AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <h3 class="fw-bold mb-4">
        <i class="fas fa-file-invoice text-primary me-2"></i>
        Chi tiết đơn hàng #@Model.MaDDH
    </h3>

    <!-- CARD THÔNG TIN -->
    <div class="card shadow border-0 rounded-4 mb-4">
        <div class="card-body">

            <div class="row">
                <div class="col-md-6">
                    <p>
                        <strong>Khách hàng:</strong>
                        @(Model.KhachHang != null ? Model.KhachHang.TenKH : "Khách vãng lai")
                    </p>

                    <p>
                        <strong>Ngày đặt:</strong>
                        @(Model.NgayDat?.ToString("dd/MM/yyyy HH:mm"))
                    </p>

                    <p>
                        <strong>Thanh toán:</strong>

                        @if (Model.DaThanhToan == true)
                        {
                            <span class="badge bg-success px-3 py-2 fw-bold">
                                Đã thanh toán
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger px-3 py-2 fw-bold">
                                Chưa thanh toán
                            </span>
                        }
                    </p>
                </div>

                <div class="col-md-6 text-md-end">
                    <p>
                        <strong>Giao hàng:</strong>
                        @if (Model.TinhTrangGiaoHang == true)
                        {
                            <span class="badge bg-success px-3 py-2">Đã giao</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark px-3 py-2">Chưa giao</span>
                        }
                    </p>

                    <p>
                        <strong>Ngày giao:</strong>
                        @(Model.NgayGiao?.ToString("dd/MM/yyyy") ?? "—")
                    </p>
                </div>
            </div>

        </div>
    </div>

    <!-- CARD SẢN PHẨM -->
    <div class="card shadow border-0 rounded-4">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle text-center">
                    <thead class="table-light fw-bold">
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Số lượng</th>
                            <th>Đơn giá</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ChiTietDonDatHang)
                        {
                            <tr>
                                <td class="fw-semibold">@item.TenSP</td>
                                <td>@item.SoLuong</td>
                                <td>@String.Format("{0:N0} đ", item.Dongia)</td>
                                <td class="fw-bold text-danger">
                                    @String.Format("{0:N0} đ", item.SoLuong * item.Dongia)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- TỔNG TIỀN -->
            <div class="text-end mt-3 fs-5 fw-bold">
                Tổng tiền:
                <span class="text-danger">
                    @String.Format("{0:N0} đ",
                        Model.ChiTietDonDatHang.Sum(x => x.SoLuong * x.Dongia))
                </span>
            </div>

            <!-- BUTTON -->
            <div class="mt-4 text-end">
                @if (Model.TinhTrangGiaoHang != true && Model.DaThanhToan == true && Model.DaHuy != true)
                {
                    using (Html.BeginForm("GiaoHang", "QuanLyDonHang", new { id = Model.MaDDH }, FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success px-4 me-2">
                            <i class="fas fa-truck me-1"></i> Giao hàng
                        </button>
                    }
                }

                @if (Model.DaHuy != true && Model.TinhTrangGiaoHang != true)
                {
                    using (Html.BeginForm("HuyDon", "QuanLyDonHang", new { id = Model.MaDDH }, FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger px-4 me-2">
                            <i class="fas fa-times me-1"></i> Hủy đơn
                        </button>
                    }
                }

                <a href="@Url.Action("ChuaThanhToan")"
                   class="btn btn-outline-secondary px-4">
                    Quay lại
                </a>
            </div>

        </div>
    </div>

</div>
